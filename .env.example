# Google Form "prefill" link exposes entry IDs as entry.123456789
NEXT_PUBLIC_GOOGLE_FORM_ID=your_form_id_from_embed_url

NEXT_PUBLIC_GF_ENTRY_ATTENDING=entry.111111111
NEXT_PUBLIC_GF_ENTRY_FIRST_NAME=entry.222222222
NEXT_PUBLIC_GF_ENTRY_LAST_NAME=entry.333333333
NEXT_PUBLIC_GF_ENTRY_MOBILE=entry.444444444
NEXT_PUBLIC_GF_ENTRY_SIDE=entry.666666666
# "Total headcount" short-answer question (members attending incl. the guest, 0 if declined)
NEXT_PUBLIC_GF_ENTRY_HEADCOUNT=entry.888888888
# Optional, legacy — old "additional guest" Yes/No question
# NEXT_PUBLIC_GF_ENTRY_PLUS_ONE=entry.555555555
# Optional — only if the Google Form has a Dietary requirements question
# NEXT_PUBLIC_GF_ENTRY_DIETARY=entry.777777777
